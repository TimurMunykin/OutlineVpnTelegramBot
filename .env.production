# Production Environment Variables
# Copy this file to .env and fill in your values

# Database
DB_PASSWORD=your_super_secure_database_password_here

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_here

# Outline VPN Configuration
OUTLINE_API_URL=https://your-outline-server:port/your-api-prefix
OUTLINE_API_FINGERPRINT=your_outline_server_fingerprint

# Removed: Telegram bot functionality has been removed

# Application Settings
NODE_ENV=production
PORT=3001

# Database Seed Credentials (required for initial setup)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password
USER_EMAIL=user@yourdomain.com
USER_PASSWORD=your_secure_user_password

# Optional: Monitoring
# SENTRY_DSN=https://your-sentry-dsn
# LOG_LEVEL=info