// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int              @id @default(autoincrement())
  email             String           @unique
  name              String
  passwordHash      String           @map("password_hash")
  role              UserRole         @default(USER)
  isEmailVerified   Boolean          @default(false) @map("is_email_verified")
  hasWebAccess      Boolean          @default(true) @map("has_web_access")
  migrationStatus   MigrationStatus? @map("migration_status")
  
  // Billing fields
  subscriptionType    SubscriptionType @default(FREE) @map("subscription_type")
  balance            Int              @default(0)
  subscriptionStartDate DateTime?      @map("subscription_start_date")
  nextBillingDate    DateTime?        @map("next_billing_date")
  subscriptionStatus SubscriptionStatus @default(ACTIVE) @map("subscription_status")
  
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  // Relations
  vpnKeys                    VpnKey[]
  oauthClients              OAuthClient[]
  userSessions              UserSession[]
  passwordResetTokens       PasswordResetToken[]
  oauthAuthorizationCodes   OAuthAuthorizationCode[]
  oauthAccessTokens         OAuthAccessToken[]
  createdVpnClients         VpnClient[]
  migratedVpnClients        VpnClient[] @relation("MigratedUser")
  usedInviteTokens          InviteToken[]
  userLimit                 UserLimit?
  balanceTransactions       BalanceTransaction[]
  performedTransactions     BalanceTransaction[] @relation("PerformedTransactions")

  @@map("users")
}

model OAuthClient {
  id           Int      @id @default(autoincrement())
  clientId     String   @unique @map("client_id")
  clientSecret String   @map("client_secret")
  name         String
  description  String?
  redirectUris String[] @map("redirect_uris")
  scopes       String[] @default(["read"])
  userId       Int      @map("user_id")
  isTrusted    Boolean  @default(false) @map("is_trusted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  user                     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthAuthorizationCodes  OAuthAuthorizationCode[]
  oauthAccessTokens        OAuthAccessToken[]

  @@map("oauth_clients")
}

model OAuthAuthorizationCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  clientId    String   @map("client_id")
  userId      Int      @map("user_id")
  redirectUri String   @map("redirect_uri")
  scopes      String[]
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("oauth_authorization_codes")
}

model OAuthAccessToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  clientId  String   @map("client_id")
  userId    Int      @map("user_id")
  scopes    String[]
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  client             OAuthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshTokens OAuthRefreshToken[]

  @@map("oauth_access_tokens")
}

model OAuthRefreshToken {
  id            Int      @id @default(autoincrement())
  token         String   @unique
  accessTokenId Int      @map("access_token_id")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  accessToken OAuthAccessToken @relation(fields: [accessTokenId], references: [id], onDelete: Cascade)

  @@map("oauth_refresh_tokens")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model VpnClient {
  id               Int              @id @default(autoincrement())
  name             String
  phone            String?
  telegramId       String?          @map("telegram_id")
  notes            String?
  migrationStatus  MigrationStatus? @map("migration_status")
  migratedToUserId Int?             @map("migrated_to_user_id")
  createdBy        Int              @map("created_by")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relations
  creator      User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  migratedUser User?        @relation("MigratedUser", fields: [migratedToUserId], references: [id])
  vpnKeys      VpnKey[]
  inviteTokens InviteToken[]

  @@map("vpn_clients")
}

model InviteToken {
  id           String    @id @default(cuid())
  vpnClientId  Int       @map("vpn_client_id")
  email        String?
  token        String    @unique
  expiresAt    DateTime  @map("expires_at")
  isUsed       Boolean   @default(false) @map("is_used")
  usedAt       DateTime? @map("used_at")
  usedByUserId Int?      @map("used_by_user_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  // Relations
  vpnClient VpnClient @relation(fields: [vpnClientId], references: [id], onDelete: Cascade)
  usedBy    User?     @relation(fields: [usedByUserId], references: [id])

  @@map("invite_tokens")
}

model VpnKey {
  id            Int      @id @default(autoincrement())
  userId        Int?     @map("user_id")
  vpnClientId   Int?     @map("vpn_client_id")
  outlineKeyId  String   @map("outline_key_id")
  accessUrl     String   @map("access_url")
  name          String?
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vpnClient VpnClient? @relation(fields: [vpnClientId], references: [id], onDelete: Cascade)

  @@map("vpn_keys")
}

model UserSession {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

enum UserRole {
  ADMIN @map("admin")
  USER  @map("user")

  @@map("user_role")
}

enum MigrationStatus {
  PENDING     @map("pending")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")

  @@map("migration_status")
}

model Setting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model UserLimit {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique @map("user_id")
  maxVpnKeys      Int?     @map("max_vpn_keys")
  canCreateKeys   Boolean  @default(true) @map("can_create_keys")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_limits")
}

model BalanceTransaction {
  id           Int                      @id @default(autoincrement())
  userId       Int                      @map("user_id")
  amount       Int                      // Positive = credit, negative = debit
  type         BalanceTransactionType
  description  String
  performedBy  Int?                     @map("performed_by") // Admin who performed the action
  createdAt    DateTime                 @default(now()) @map("created_at")

  // Relations
  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  performedByUser User? @relation(fields: [performedBy], references: [id], name: "PerformedTransactions")

  @@map("balance_transactions")
}

enum SubscriptionType {
  FREE @map("free")
  PAID @map("paid")

  @@map("subscription_type")
}

enum SubscriptionStatus {
  ACTIVE               @map("active")
  INSUFFICIENT_BALANCE @map("insufficient_balance")

  @@map("subscription_status")
}

enum BalanceTransactionType {
  PAYMENT         @map("payment")
  MONTHLY_CHARGE  @map("monthly_charge") 
  ADMIN_ADJUSTMENT @map("admin_adjustment")

  @@map("balance_transaction_type")
}